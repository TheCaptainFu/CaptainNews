/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https://captainnews-worker.g-gsmks.workers.dev https://api.open-meteo.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; worker-src 'self'; manifest-src 'self'

/*.html
  Cache-Control: no-cache, must-revalidate

/contact
  Cache-Control: no-cache, must-revalidate

/policy
  Cache-Control: no-cache, must-revalidate

# The service worker proxies images from every news site; under the page CSP
# its fetch() would be limited to connect-src and all photos would break.
/sw.js
  Cache-Control: no-cache, must-revalidate
  ! Content-Security-Policy

/src/*.css
  Cache-Control: public, max-age=86400

/js/*.js
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800, immutable

/manifest.json
  Cache-Control: public, max-age=86400

/greece
  Cache-Control: no-cache, must-revalidate

/greece/
  Cache-Control: no-cache, must-revalidate

/politics
  Cache-Control: no-cache, must-revalidate

/politics/
  Cache-Control: no-cache, must-revalidate

/world
  Cache-Control: no-cache, must-revalidate

/world/
  Cache-Control: no-cache, must-revalidate

/sports
  Cache-Control: no-cache, must-revalidate

/sports/
  Cache-Control: no-cache, must-revalidate

/technology
  Cache-Control: no-cache, must-revalidate

/technology/
  Cache-Control: no-cache, must-revalidate

/music
  Cache-Control: no-cache, must-revalidate

/music/
  Cache-Control: no-cache, must-revalidate

/mundial
  Cache-Control: no-cache, must-revalidate

/mundial/
  Cache-Control: no-cache, must-revalidate
